# ==============================================================================
# CampusPulse AI - Environment Configuration
# Copy this file to .env and supply your API credentials.
# Never commit real API keys to version control.
# ==============================================================================

# ===== PRIMARY: Gemma 4 & Google Gemini API Configuration =====
# Obtain your Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 4 Model Selection (Default: gemma-4-26b-a4b-it, Alternative: gemma-4-31b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it

# ===== Flask Server Configuration =====
SECRET_KEY=campuspulse-secret-key-change-in-production
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# ===== Optional: Campus Reaction Simulation Sandbox =====
# Multi-agent simulation requires an OpenAI-compatible API and Zep Cloud key.
# Notice-to-Action works independently and does not require these.
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
ZEP_API_KEY=your_zep_api_key_here

# Simulation Tuning (Optional)
OASIS_DEFAULT_MAX_ROUNDS=10
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5
