# Runtime configuration. Copy this file to .env and replace placeholder values.
# Do not commit .env or pass it to docker build.

# Flask deployment settings
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# Legacy MiroFish simulation/report features only. They are validated when a
# feature that uses them is invoked, so the health endpoint can run without
# either credential.
LLM_API_KEY=your_legacy_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
ZEP_API_KEY=your_zep_cloud_api_key
VALIDATE_LEGACY_CREDENTIALS=false

# Optional simulation and report tuning.
OASIS_DEFAULT_MAX_ROUNDS=10
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5
